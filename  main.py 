    特斯拉, 2023, 967.7亿美元, 15.5%
    风险提示：原材料价格波动可能影响利润率。
    """
    
    print("\n=== 任务 2: 处理 PDF 表格数据 ===")
    agent.run(mock_pdf_table_content, "PDF Table")

    # 打印最终数据库状态
    print("\n=== 📊 最终入库数据概览 ===")
    print(json.dumps(fake_database, indent=2, ensure_ascii=False))

if __name__ == "__main__":
    main()
